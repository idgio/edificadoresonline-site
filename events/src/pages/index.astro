---
import '../styles/global.css';

const churchUrl = 'https://edificadoresonline.com';
const event = {
  name: 'Awake',
  date: 'Fecha por anunciar',
  time: 'Hora por anunciar',
  place: 'Lugar por confirmar',
};

const questions = [
  {
    question: '¿Cuándo será?',
    answer: 'La fecha y la hora todavía no están confirmadas. Las publicaremos aquí cuando estén listas.',
  },
  {
    question: '¿Dónde nos vemos?',
    answer: 'El lugar está por confirmar. Esta página tendrá la dirección antes del encuentro.',
  },
  {
    question: '¿Hay que registrarse?',
    answer: 'Aún no se ha anunciado si será necesario registrarse. Revisa esta página para conocer los detalles.',
  },
  {
    question: '¿Puedo compartir la invitación?',
    answer: 'Sí. Usa el botón «Compartir Awake» para enviar esta página a alguien más.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f36b48" />
    <meta name="description" content="Awake: un encuentro para jóvenes de EdificadoresOnline. Pronto compartiremos fecha, hora y lugar." />
    <link rel="canonical" href="https://awake.edificadoresonline.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@900&family=Red+Hat+Text:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>Awake — Encuentro de jóvenes</title>
  </head>
  <body>
    <main>
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <header class="site-header frame">
          <a class="wordmark" href="#inicio" aria-label="Awake, volver al inicio">awake<span aria-hidden="true">.</span></a>
          <a class="header-link" href="#detalles">Ver detalles <span aria-hidden="true">↗</span></a>
        </header>

        <div class="hero-title" id="hero-title">
          <h1 class="hero-title-top"><span class="masked-line">DESPIERTA</span><span class="masked-line">ALGO NUEVO</span></h1>
          <div class="hero-title-bottom" aria-hidden="true"><span>DESPIERTA</span><span>ALGO NUEVO</span></div>
        </div>

        <div class="hero-bottom frame">
          <p><strong>Awake</strong> es un encuentro para jóvenes: una noche para hacer espacio a la fe, la música y la comunidad.</p>
          <a class="text-link" href="#detalles">Conoce el encuentro <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="intro-board" id="encuentro" aria-labelledby="intro-title">
        <div class="board">
          <div class="board-statement"><h2 id="intro-title">HAY MÁS<br />POR VIVIR.</h2></div>
          <div class="board-name" aria-label="Awake">AWAKE</div>
          <div class="board-photo"><img src="/images/worship.webp" width="1200" height="1600" loading="lazy" alt="Persona participando en un momento de adoración en la iglesia" /></div>
        </div>
        <div class="intro-copy frame">
          <p>Hay momentos que nos invitan a parar y escuchar. Awake nace como un espacio para que los jóvenes busquemos a Dios juntos, compartamos con otros y salgamos con una mirada renovada.</p>
        </div>
      </section>

      <section class="details frame" id="detalles" aria-labelledby="details-title">
        <div class="details-heading">
          <h2 id="details-title">Lo que sabemos</h2>
          <p>Estamos preparando el encuentro. Guarda esta página: aquí aparecerá la información confirmada.</p>
        </div>
        <div class="detail-grid">
          <div class="detail-item"><span>Fecha</span><strong>{event.date}</strong></div>
          <div class="detail-item"><span>Hora</span><strong>{event.time}</strong></div>
          <div class="detail-item"><span>Lugar</span><strong>{event.place}</strong></div>
        </div>
      </section>

      <section class="photo-sequence" aria-labelledby="community-title">
        <div class="frame photo-heading">
          <h2 id="community-title">Nos encontramos<br />en comunidad.</h2>
          <p>Momentos de la vida de nuestra iglesia.</p>
        </div>
        <div class="photo-grid frame">
          <figure class="photo-large"><img src="/images/gathering.webp" width="1600" height="1067" loading="lazy" alt="Personas reunidas durante un servicio de la iglesia" /><figcaption>Juntos</figcaption></figure>
          <figure><img src="/images/young-speaker.webp" width="1600" height="1067" loading="lazy" alt="Joven compartiendo un mensaje en la iglesia" /><figcaption>Escuchamos</figcaption></figure>
          <figure><img src="/images/prayer.webp" width="1600" height="1067" loading="lazy" alt="Grupo de personas orando en la iglesia" /><figcaption>Oramos</figcaption></figure>
        </div>
      </section>

      <section class="faq frame" id="preguntas" aria-labelledby="faq-title">
        <h2 id="faq-title">Preguntas<br />frecuentes</h2>
        <div class="faq-list">
          {questions.map(({ question, answer }) => (
            <details name="awake-faq"><summary>{question}<span class="faq-icon" aria-hidden="true"></span></summary><p>{answer}</p></details>
          ))}
        </div>
      </section>

      <section class="closing" id="comparte" aria-labelledby="closing-title">
        <div class="frame closing-inner">
          <h2 id="closing-title">ESTO APENAS<br />COMIENZA.</h2>
          <div class="closing-bottom">
            <p>Invita a alguien a estar pendiente de Awake contigo.</p>
            <button type="button" id="share-button" class="share-button">Compartir Awake <span aria-hidden="true">↗</span></button>
          </div>
          <p id="share-feedback" class="share-feedback" role="status" aria-live="polite"></p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-photo"><img src="/images/community.webp" width="1600" height="1067" loading="lazy" alt="Persona levantando la mano durante un bautismo en la iglesia" /></div>
      <div class="footer-content">
        <a class="footer-wordmark" href="#inicio">awake<span aria-hidden="true">.</span></a>
        <nav aria-label="Enlaces del sitio">
          <a href="#encuentro">El encuentro</a>
          <a href="#detalles">Detalles</a>
          <a href="#preguntas">Preguntas</a>
          <a href={churchUrl}>EdificadoresOnline ↗</a>
        </nav>
        <p>Awake es parte de <a href={churchUrl}>EdificadoresOnline</a>.</p>
        <small>© {new Date().getFullYear()} EdificadoresOnline</small>
      </div>
    </footer>

    <script>
      const shareButton = document.querySelector<HTMLButtonElement>('#share-button');
      const feedback = document.querySelector<HTMLElement>('#share-feedback');
      shareButton?.addEventListener('click', async () => {
        const url = window.location.href.split('#')[0];
        const message = 'Awake: un encuentro para jóvenes de EdificadoresOnline.';
        try {
          if (navigator.share) {
            await navigator.share({ title: 'Awake', text: message, url });
            if (feedback) feedback.textContent = '¡Gracias por compartir!';
          } else if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(url);
            if (feedback) feedback.textContent = 'Enlace copiado. ¡Compártelo con alguien!';
          } else {
            window.location.href = `mailto:?subject=${encodeURIComponent('Awake')}&body=${encodeURIComponent(`${message}\n${url}`)}`;
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          if (feedback) feedback.textContent = 'No pudimos compartir el enlace. Puedes copiar la dirección de esta página.';
        }
      });
    </script>
  </body>
</html>
