---
import '../styles/global.css';

const churchUrl = 'https://edificadoresonline.com';
const playlistUrl = 'https://open.spotify.com/playlist/4b8n3kaHHaJz4EP5ziMBKO?si=q6C292KzSwu0csUb5XgjXg&utm_source=whatsapp&pi=iXLLIZmhTHWxR';
const mapsUrl = 'https://maps.app.goo.gl/F5foaEa865asmgMm9';
const wazeUrl = 'https://ul.waze.com/ul?venue_id=177471625.1774650716.8843565&overview=yes&utm_campaign=live_map&utm_source=waze_website&utm_medium=lm_share_location';
const questions = [
  { question: '¿Para quién es Awake?', answer: 'La invitación a Awake es para jóvenes mayores de 13 años.' },
  { question: '¿Cuánto cuesta?', answer: 'La entrada es totalmente gratis. Después del encuentro habrá pupusas gratis en el after church.' },
  { question: '¿Dónde será?', answer: 'Nos vemos en Templo Edificadores el sábado 14 de noviembre a las 5:30 p. m. Puedes abrir la ubicación en Google Maps o Waze desde la sección «Dónde nos vemos».' },
  { question: '¿Qué pasará esa noche?', answer: 'Pronto compartiremos más detalles.' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#355a78" />
    <meta name="description" content="Awake: una generación despierta. Sábado 14 de noviembre de 2026, 5:30 p. m., Templo Edificadores. Gratis, para jóvenes mayores de 13 años." />
    <meta property="og:title" content="Awake — Una generación despierta" />
    <meta property="og:description" content="14 de noviembre · 5:30 p. m. · Templo Edificadores. Entrada gratis y pupusas después del encuentro." />
    <meta property="og:image" content="https://awake.edificadoresonline.com/images/awake/post.jpg" />
    <link rel="canonical" href="https://awake.edificadoresonline.com/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Awake — Una generación despierta</title>
  </head>
  <body>
    <header class="site-header frame">
      <a class="brand" href="#inicio" aria-label="Generación Edificadores, inicio"><span class="brand-monogram">GE</span><span class="brand-name">GENERACIÓN<br />EDIFICADORES</span></a>
      <nav aria-label="Navegación principal"><a href="#generacion">La generación</a><a href="#detalles">El evento</a><a href="#ubicacion">Cómo llegar</a></nav>
      <a class="header-action" href="#detalles">Nos vemos el 14 <span aria-hidden="true">↗</span></a>
    </header>
    <main>
      <section class="hero frame" id="inicio" aria-labelledby="hero-title">
        <div class="hero-meta"><span>Congreso de jóvenes</span><span>14 noviembre 2026 · 5:30 p. m.</span></div>
        <div class="hero-core"><div class="hero-title-block"><p class="hero-script">una generación</p><h1 id="hero-title"><span>AWAKE</span></h1></div><p class="hero-intro">Awake es el congreso de jóvenes donde comienza una nueva etapa de Generación Edificadores. Ven a vivirla con nosotros.</p></div>
        <div class="hero-bottom"><a class="primary-link" href="#detalles">Ver detalles del evento <span aria-hidden="true">↗</span></a><p>Templo Edificadores · Entrada gratis</p></div>
      </section>
      <section class="manifesto frame" id="generacion" aria-labelledby="manifesto-title">
        <div class="manifesto-heading"><h2 id="manifesto-title">Una generación</h2><img src="/images/awake/GE_logo.png" alt="Monograma oficial de Generación Edificadores" width="900" height="650" loading="lazy" /></div>
        <p>Generación Edificadores es una comunidad que busca conocer a Jesús, representarlo y caminar con propósito. En Awake nos reuniremos para celebrar lo que Dios está haciendo y vivir juntos el comienzo de una nueva etapa.</p>
        <blockquote class="manifesto-verse"><p>«Generación a generación celebrará tus obras, y anunciará tus poderosos hechos»</p><cite>Salmo 145:4 · RVR1960</cite></blockquote>
      </section>
      <section class="event-details" id="detalles" aria-labelledby="details-title"><div class="frame event-layout">
        <div class="event-copy"><h2 id="details-title">Nos vemos<br />en Awake</h2><div class="event-facts">
          <p><span>Cuándo</span><strong><time datetime="2026-11-14T17:30:00-06:00">Sábado 14 de noviembre<br />5:30 p. m.</time></strong></p>
          <p><span>Dónde</span><strong>Templo Edificadores</strong></p><p><span>Para quién</span><strong>Jóvenes mayores de 13 años</strong></p><p><span>Entrada</span><strong>Gratis</strong></p>
        </div><div class="after-church"><p>After church con pupusas gratis</p></div></div>
        <figure class="event-poster"><img src="/images/awake/post.jpg" alt="Flyer oficial de Awake: 14 de noviembre, 5:30 p. m., Templo Edificadores, entrada y pupusas gratis" width="1080" height="1440" loading="lazy" /></figure>
      </div></section>
      <section class="find-us frame" id="ubicacion" aria-labelledby="location-title"><div><h2 id="location-title">Dónde nos vemos</h2><p>Nos vemos en Templo Edificadores. Abre la ruta en tu app de mapas antes de salir.</p></div><div class="map-links"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir Google Maps <span aria-hidden="true">↗</span></a><a href={wazeUrl} target="_blank" rel="noopener noreferrer">Abrir Waze <span aria-hidden="true">↗</span></a></div></section>
      <section class="soundtrack frame" aria-labelledby="playlist-title"><div><h2 id="playlist-title">La música<br />antes de vernos</h2><p>Escucha la playlist de Awake y comparte lo que viene con alguien más.</p></div><a href={playlistUrl} target="_blank" rel="noopener noreferrer">Escuchar en Spotify <span aria-hidden="true">↗</span></a></section>
      <section class="faq frame" id="preguntas" aria-labelledby="faq-title"><h2 id="faq-title">Antes de llegar</h2><div class="faq-list">{questions.map(({ question, answer }) => (<details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>))}</div></section>
      <section class="closing frame" id="comparte" aria-labelledby="closing-title"><div><h2 id="closing-title">Nos vemos<br />despiertos</h2><p>14 de noviembre · 5:30 p. m. · Templo Edificadores</p></div><div class="closing-actions"><button type="button" id="share-button">Compartir Awake <span aria-hidden="true">↗</span></button><p id="share-feedback" role="status" aria-live="polite"></p></div></section>
    </main>
    <footer class="footer frame"><a class="footer-brand" href="#inicio">AWAKE</a><p>Una generación despierta</p><nav aria-label="Enlaces del pie de página"><a href="#generacion">La generación</a><a href="#detalles">El evento</a><a href="#ubicacion">Cómo llegar</a><a href={churchUrl}>EdificadoresOnline ↗</a></nav><small>© {new Date().getFullYear()} Generación Edificadores</small></footer>
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const animated = document.querySelectorAll('.manifesto h2, .manifesto > p, .event-copy h2, .event-facts, .after-church, .event-poster, .find-us h2, .map-links, .soundtrack h2, .soundtrack > a, .faq h2, .faq-list, .closing h2, .closing-actions');
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.animate([{ opacity: .45, transform: 'translateY(22px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 550, easing: 'cubic-bezier(.2,.7,.2,1)' });
            observer.unobserve(entry.target);
          }
        }, { threshold: .08 });
        animated.forEach((element) => observer.observe(element));
      }
      const shareButton = document.querySelector<HTMLButtonElement>('#share-button');
      const feedback = document.querySelector<HTMLElement>('#share-feedback');
      shareButton?.addEventListener('click', async () => {
        const url = window.location.href.split('#')[0];
        const message = 'Awake: una generación despierta. 14 de noviembre, 5:30 p. m., Templo Edificadores.';
        try {
          if (navigator.share) { await navigator.share({ title: 'Awake', text: message, url }); if (feedback) feedback.textContent = '¡Gracias por compartir!'; }
          else if (navigator.clipboard?.writeText) { await navigator.clipboard.writeText(url); if (feedback) feedback.textContent = 'Enlace copiado. ¡Compártelo con alguien!'; }
          else { window.location.href = `mailto:?subject=${encodeURIComponent('Awake')}&body=${encodeURIComponent(`${message}\n${url}`)}`; }
        } catch (error) { if (error instanceof DOMException && error.name === 'AbortError') return; if (feedback) feedback.textContent = 'No pudimos compartir el enlace. Copia la dirección de esta página.'; }
      });
    </script>
  </body>
</html>
